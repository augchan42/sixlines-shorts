  },
  "03": {
   "text": "Wang Bi offered some reading instructions.",
   "model": "eleven_v4",
   "voiceId": "WdZjiN0nNcik2LBjOHiv",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
