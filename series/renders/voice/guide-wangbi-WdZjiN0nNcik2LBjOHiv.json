   "made": "2026-09-30T14:02:39.941Z"
  },
  "04": {
   "text": "He died young. His commentary became a standard for centuries.",
   "model": "eleven_v4",
   "voiceId": "WdZjiN0nNcik2LBjOHiv",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
