   },
   "seconds": 3.68,
   "sha256": "a82d340a5103b48f68d295dad44d480fbfaa3476bb9b4b9bd2ca3505657756a7",
   "made": "2026-09-30T14:02:44.393Z"
  },
  "06": {
   "text": "Borrowing from Zhuangzi: an image is a fish trap. Catch the fish; put down the trap.",
   "model": "eleven_v4",
   "voiceId": "WdZjiN0nNcik2LBjOHiv",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
