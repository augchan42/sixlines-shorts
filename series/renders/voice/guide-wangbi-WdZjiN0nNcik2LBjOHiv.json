   "seconds": 4.96,
   "sha256": "5adf1350b643a12bea90a0cbbaa8b1aee13e9b7753a51056bffc4bbb67c54d5b",
   "made": "2026-09-30T14:02:42.375Z"
  },
  "05": {
   "text": "Grasp the meaning. Then forget the image.",
   "model": "eleven_v4",
   "voiceId": "WdZjiN0nNcik2LBjOHiv",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
