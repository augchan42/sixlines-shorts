   "made": "2026-09-30T14:07:46.103Z"
  },
  "05": {
   "text": "Grasp the meaning. Then forget the image.",
   "model": "eleven_v4",
   "voiceId": "hYDmtgsUa8Lf6Ql57aI5",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
