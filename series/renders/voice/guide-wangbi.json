   "made": "2026-09-30T14:07:43.552Z"
  },
  "04": {
   "text": "He died young. His commentary became a standard for centuries.",
   "model": "eleven_v4",
   "voiceId": "hYDmtgsUa8Lf6Ql57aI5",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
