   },
   "seconds": 3.68,
   "sha256": "dc4220c900ba3001055b6688962938bfd220c3d724e04606c97355d52ec88c7f",
   "made": "2026-09-30T14:07:48.248Z"
  },
  "06": {
   "text": "Borrowing from Zhuangzi: an image is a fish trap. Catch the fish; put down the trap.",
   "model": "eleven_v4",
   "voiceId": "hYDmtgsUa8Lf6Ql57aI5",
   "settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
