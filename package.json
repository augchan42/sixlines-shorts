{
  "name": "sixlines-shorts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "blender": "node scripts/blender.mjs",
    "studio": "remotion studio",
    "render": "remotion render src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.mjs' && python3 -m unittest discover -s blender -p 'test_*.py' && python3 -m unittest discover -s music -p 'test_*.py'",
    "assets": "node scripts/fetch-assets.mjs",
    "series:table": "node scripts/series-table.mjs",
    "series:clips": "node scripts/series-clips.mjs",
    "series:screens": "node scripts/series-screens.mjs",
    "series": "node scripts/series.mjs",
    "series:captions": "node scripts/series-captions.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.527",
    "@remotion/fonts": "^4.0.527",
    "@remotion/google-fonts": "^4.0.527",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.527",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
